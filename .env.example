# Copy to .env and fill in. docker compose reads .env automatically.

# --- Meilisearch -------------------------------------------------------------------
# REQUIRED for docker compose. Must be at least 16 bytes; Meilisearch runs with
# MEILI_ENV=production and refuses weak keys. Generate one with:
#   openssl rand -base64 32
MEILI_MASTER_KEY=
# Host used by `pnpm dev` / sync scripts outside Docker. Leave unset to skip indexing.
MEILI_HOST=http://localhost:7700
# Optional search-only API key. When set, the web app uses it for search queries
# instead of the master key (create one via the Meilisearch /keys API).
MEILI_SEARCH_KEY=

# --- Web app -----------------------------------------------------------------------
# When set, this token is required to trigger sync jobs via /api/jobs.
# If empty, anyone who can reach the app can trigger jobs.
# Generate with: openssl rand -hex 32
JOBS_ADMIN_TOKEN=
# Set to "true" only behind a trusted reverse proxy: the app then honours
# X-Forwarded-For for client IPs (rate limiting). Otherwise it is ignored.
TRUST_PROXY=false

# --- Local LLM (Ollama) ------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Sync scripts ------------------------------------------------------------------
# Linux bind mounts need an identity that can write to ./data. Set these to the
# owning user's numeric UID and GID when they differ from the default 1000:1000.
ISM_SYNC_UID=1000
ISM_SYNC_GID=1000
# "all" (default) or a positive integer: caps how many NEW ISM releases are downloaded
# per run. Releases already in data/ism/releases are never re-downloaded or dropped.
ISM_RELEASE_COUNT=all
# Optional GitHub token; raises the GitHub API rate limit for ISM release discovery.
GITHUB_TOKEN=
