{
  "name": "ism-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/standalone-assets.mjs",
    "start": "HOSTNAME=${HOSTNAME:-0.0.0.0} ISM_DATA_DIR=\"${ISM_DATA_DIR:-$PWD/data/ism}\" ACSC_DATA_DIR=\"${ACSC_DATA_DIR:-$PWD/data/acsc}\" node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.*\"",
    "sync:ism": "node scripts/sync-ism.mjs",
    "sync:acsc": "node scripts/sync-acsc-advisories.mjs",
    "sync:index": "ISM_RELEASE_COUNT=all MEILI_HOST=${MEILI_HOST:-http://localhost:7700} node scripts/sync-ism.mjs",
    "build:site": "node scripts/build-site.mjs",
    "jobs:worker": "node scripts/work-jobs.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "ollama:pull": "docker compose exec ollama ollama pull llama3.2:3b",
    "docker:up": "docker compose up --build"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "bullmq": "^6.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "^9.15.1",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "1.66.0",
    "meilisearch": "0.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32"
    },
    "ignoredBuiltDependencies": [
      "core-js",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
